# The one place the version lives.
#
# `FDK_AAC_SHA256` is checked before anything is unpacked, so a tarball that is not the
# one this repo was pinned to stops the build instead of silently becoming the artifact
# everything links against. Recompute it when bumping:
#
#   curl -sSLO https://downloads.sourceforge.net/project/opencore-amr/fdk-aac/fdk-aac-<version>.tar.gz
#   shasum -a 256 fdk-aac-<version>.tar.gz
#
# 2.0.3 is the newest tag upstream has; there is no 2.0.4.
FDK_AAC_VERSION=2.0.3
FDK_AAC_SHA256=829b6b89eef382409cda6857fd82af84fabb63417b08ede9ea7a553f811cb79e

# SourceForge rather than GitHub, and this is not an arbitrary preference.
#
# github.com/mstorsjo/fdk-aac has no *releases* — only tags — and GitHub's auto-generated
# tag tarballs carry no stability guarantee: they are produced on demand by `git archive`,
# and a change in how git spells a tar header rewrites the bytes of every one of them. A
# committed SHA-256 against that URL is a build that breaks for reasons nobody caused.
#
# The opencore-amr project on SourceForge is where the maintainer publishes the `make dist`
# tarballs, and it is what distributions build from. The files are immutable, which is the
# only property a pin needs. This is the same role downloads.xiph.org plays for libopus.
FDK_AAC_SOURCE_BASE=https://downloads.sourceforge.net/project/opencore-amr/fdk-aac

# Where the built archives are published. Read by sync-prebuilt.sh and by
# crates/fdk-aac-prebuilt-sys/build.rs, so that a fork changes this in one place rather
# than in two scripts and a build script.
PREBUILT_REPO=andrewtheguy/fdk-aac-prebuilt
